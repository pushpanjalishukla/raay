# Optional: enables Claude-powered labelling, insights and reply drafts.
ANTHROPIC_API_KEY=
# Optional: Claude model ID (default claude-opus-5-5). claude-haiku-5-5 is much cheaper.
RAAY_MODEL=
# Optional: fresh AI analyses allowed per visitor IP per hour (default 5).
RAAY_AI_PER_IP_PER_HOUR=
# Optional: public link for "Talk to us" buttons.
NEXT_PUBLIC_CONTACT_URL=
# Accounts (Clerk). Add via Vercel → Integrations → Clerk, or from dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Payments (Razorpay). Dashboard → Account & Settings → API keys / Webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: use existing Razorpay plan ids instead of auto-creating "Raay Starter" / "Raay Growth".
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
# Optional: one-time free allowance per account (default 3 reports / 5 questions).
NEXT_PUBLIC_FREE_REPORTS=
NEXT_PUBLIC_FREE_QUESTIONS=
